# Docker Compose settings (this file is read by docker compose). Copy to .env and fill in.
# Your domain, already pointing at this server (A record). The site will be https://<DOMAIN>
DOMAIN=www.example.com
# Email for the free HTTPS certificate (Let's Encrypt) notices
ACME_EMAIL=you@example.com
# Database password – long and random: openssl rand -hex 24
MONGO_PASSWORD=
# Optional
DB_NAME=sellandiamman_estates
BACKUP_KEEP_DAYS=30
MAP_TILES=
MAP_ATTRIBUTION=
# Only when nginx already serves other sites on this server (ports 80/443 taken): nginx does HTTPS and forwards to
# Caddy on a local port. Leave these out on a server of its own.
# SITE_ADDRESS=:80
# HTTP_BIND=127.0.0.1:8088
# HTTPS_BIND=127.0.0.1:8443
