# Public address of the site, used in share links and social preview tags. Build-time value.
REACT_APP_SITE_URL=https://www.example.com
# Leave empty when the API is served from the same address (the default with Caddy). Only set it for a separate API host.
REACT_APP_BACKEND_URL=
# Optional map tiles from a provider with a key (defaults to OpenStreetMap). Update the CSP in deploy/Caddyfile too.
REACT_APP_MAP_TILES=
REACT_APP_MAP_ATTRIBUTION=
