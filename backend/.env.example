# Copy to backend/.env and fill in. Never commit the real .env.
# With docker compose, MONGO_URL, SITE_URL, CORS_ORIGINS, UPLOAD_DIR and COOKIE_SECURE are set from the top-level .env,
# so you only need the values from JWT_SECRET down. The lines below are for running the backend on its own.
MONGO_URL=mongodb://localhost:27017
DB_NAME=sellandiamman_estates
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
# Public address of the site (used in emails, sitemap, brochure QR codes)
SITE_URL=https://www.example.com
# Comma-separated browser origins allowed to call the API (normally just SITE_URL)
CORS_ORIGINS=https://www.example.com
# First Super Administrator, created on the first start only. Remove ADMIN_PASSWORD after you have signed in
# and changed the password. ADMIN_RESET_PASSWORD=true resets it from here on the next start (emergency only).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Sample data - keep false on the live server
SEED_DEMO=false
DEMO_PASSWORD=
# Uploaded files (private). In Docker this is a named volume.
UPLOAD_DIR=/data/uploads
# Secure cookies need HTTPS. Only set false for local development over http://localhost.
COOKIE_SECURE=true
# Email (activation/reset links and notifications). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sellandiamman Estates <no-reply@example.com>
# starttls (default), ssl, or none
SMTP_TLS=starttls
# Optional Cloudflare Turnstile "I am human" check on public forms
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
